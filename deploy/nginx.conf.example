# Adapt domain, paths and PHP-FPM socket. Add your own TLS certificate configuration.
# This HTTP-only example is for a private staging listener. Production must use HTTPS.
server {
    listen 80;
    server_name siakad.domain-kampus.ac.id;
    root /var/www/siakad/public;
    index index.php;
    charset utf-8;
    client_max_body_size 2m;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location /assets/ {
        try_files $uri =404;
        # Unversioned asset filenames: revalidate on every release.
        add_header Cache-Control "public, no-cache";
        add_header X-Content-Type-Options "nosniff" always;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
